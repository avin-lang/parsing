module tests

import dev.avinlang.parsing.{Error, Failure, Parser, ParseResult, Positional, Success, parseAll, wholeNumber}

// A whole number as a `long`.
lazy val number: Parser[long] = wholeNumber ^^ (s -> s.toLong().getOrElse(0))

// A parse's result as one line: the value displayed, or `failure` or `error`, the position and the
// message.
shown[T: Display](r: ParseResult[T]) -> string = r match
    Success(v, _) -> s"$v"
    Failure(m, n) -> s"failure ${n.pos()}: $m"
    Error(m, n) -> s"error ${n.pos()}: $m"

// `parseAll(p, text)`, shown.
all[T: Display](p: Parser[T], text: string) -> string = shown(parseAll(p, text))

// A syntax tree node that remembers where it began, in the field `Positional` gives it.
class Node(val text: string): Positional
    // The text and the line and column the node began at, or `?` before it has one.
    where() -> string = pos match
        Some(p) -> s"$text@$p"
        None -> s"$text@?"
