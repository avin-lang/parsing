module tests

import dev.avinlang.parsing.{Error, Failure, Parser, ParseResult, Success, parseAll, wholeNumber}

// A whole number as a `long`.
lazy val number: Parser[long] = wholeNumber ^^ (s -> s.toLong().getOrElse(0))

// A parse's result as one line: the value displayed, or `failure` or `error`, the position and the
// message.
shown[T: Display](r: ParseResult[T]) -> string = r match
    Success(v, _) -> s"$v"
    Failure(m, n) -> s"failure ${n.pos()}: $m"
    Error(m, n) -> s"error ${n.pos()}: $m"

// `parseAll(p, text)`, shown.
all[T: Display](p: Parser[T], text: string) -> string = shown(parseAll(p, text))
