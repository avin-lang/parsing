module tests

// JSON parsed into a data type and printed back: objects, arrays, strings with escapes, numbers,
// `true`, `false` and `null`, nested and empty, with white space before any token. Printing a parsed
// document and parsing the print gives the same value, and a document of more than a megabyte parses
// well inside the time a test is given. A string is kept as written, escapes and all.
import dev.avinlang.parsing.{Parser, Success, floatingPointNumber, literal, parseAll, repsep, stringLiteral}

data Json
    JNull
    JBool(value: bool)
    JNumber(value: real)
    JString(written: string)
    JArray(items: List[Json])
    JObject(fields: List[(string, Json)])

lazy val value: Parser[Json] = literal("null") ^^^ JNull
    | literal("true") ^^^ JBool(true)
    | literal("false") ^^^ JBool(false)
    | floatingPointNumber ^^ (x -> JNumber(x.toRealOption().getOrElse(0.0)))
    | stringLiteral ^^ (s -> JString(s))
    | array
    | obj

lazy val array: Parser[Json] = literal("[") ~> repsep(value, literal(",")) <~ literal("]") ^^ (items -> JArray(items))

lazy val field: Parser[(string, Json)] = stringLiteral <~ literal(":") ~ value

lazy val obj: Parser[Json] = literal("{") ~> repsep(field, literal(",")) <~ literal("}") ^^ (fields -> JObject(fields))

printed(j: Json) -> string = j match
    JNull -> "null"
    JBool(b) -> s"$b"
    JNumber(x) -> s"$x"
    JString(s) -> s
    JArray(items) -> items.map(printed).mkString("[", ",", "]")
    JObject(fields) -> fields.map((k, v) -> s"$k:${printed(v)}").mkString("{", ",", "}")

// `text` parsed and printed, checking that the print parses to the same value.
roundTrip(text: string) -> string
    parseAll(value, text) match
        Success(j, _) ->
            val out = printed(j)
            assert(parseAll(value, out).getOrElse(JNull) == j, s"$out parses to a different value")
            out
        r -> shown(r)

@test("literals and empty collections")
jsonLiterals()
    assertEq(roundTrip("null"), "null")
    assertEq(roundTrip(" true "), "true")
    assertEq(roundTrip("false"), "false")
    assertEq(roundTrip("[]"), "[]")
    assertEq(roundTrip("{}"), "{}")
    assertEq(roundTrip("[ ]"), "[]")
    assertEq(roundTrip("{ }"), "{}")
    assertEq(roundTrip("[[], [[]], {}]"), "[[],[[]],{}]")

@test("numbers with fractions and exponents")
jsonNumbers()
    assertEq(roundTrip("0"), "0")
    assertEq(roundTrip("-12"), "-12")
    assertEq(roundTrip("3.25"), "3.25")
    assertEq(roundTrip("-0.5e2"), "-50")
    assertEq(roundTrip("1E3"), "1000")
    assertEq(roundTrip("2.5e-3"), "0.0025")

@test("strings kept as written")
escapedStrings()
    assertEq(roundTrip("\"\""), "\"\"")
    assertEq(roundTrip("\"plain\""), "\"plain\"")
    assertEq(roundTrip("\"q\\\" b\\\\ n\\n t\\t\""), "\"q\\\" b\\\\ n\\n t\\t\"")
    assertEq(roundTrip("\"\\ud83d\\ude00\""), "\"\\ud83d\\ude00\"")
    assertEq(roundTrip("\"café \u{1F600}\""), "\"café \u{1F600}\"")

@test("objects and arrays nested, with white space between tokens")
jsonNested()
    assertEq(roundTrip("{\"name\": \"avin\", \"tags\": [\"fast\", \"small\"], \"version\": 1, \"stable\": false, \"next\": null}"), "{\"name\":\"avin\",\"tags\":[\"fast\",\"small\"],\"version\":1,\"stable\":false,\"next\":null}")
    assertEq(roundTrip("\n{\n  \"a\" : {\n    \"b\" : [ 1 , 2 , { \"c\" : [ ] } ]\n  }\n}\n"), "{\"a\":{\"b\":[1,2,{\"c\":[]}]}}")
    assertEq(roundTrip("{\"a\": [1, 2,]}"), "failure 1:13: expected `null`, `true`, `false`, floating-point number, string, `[` or `{`, found ']'")

@test("a document of more than a megabyte")
jsonLarge()
    val body = (0..<10000).map(i -> s"  {\"id\": $i, \"name\": \"item \\\"number\\\" $i\", \"price\": ${i}.25, \"tags\": [\"a\", \"b\\n\", \"\\u00e9\"], \"ok\": true, \"none\": null}").mkString(",\n")
    val text = s"[\n$body\n]\n"
    assert(text.byteLength() > 1000000)
    parseAll(value, text) match
        Success(JArray(items), _) ->
            val fields = items.flatMap(match
                JObject(fs) -> fs
                _ -> Nil)
            val ids = fields.collect(match ("\"id\"", JNumber(n)) -> n).sum()
            val prices = fields.collect(match ("\"price\"", JNumber(p)) -> p).sum()
            val names = fields.count(match
                ("\"name\"", JString(s)) -> s.startsWith("\"item \\\"number\\\" ")
                _ -> false)
            assertEq(s"${items.length()} $ids $prices $names", "10000 49995000 49997500 10000")
        r -> assert(false, shown(r.map(printed)))
