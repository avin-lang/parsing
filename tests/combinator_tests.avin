module tests

// The combinators at their edges: repetitions of nothing, a fixed number and a different first,
// optional parts, separators, chains of one and chains into another type, look ahead, positions, a
// parser chosen by a value, a value filtered and mapped at once, the longest of two matches, and
// prefixes.
import dev.avinlang.parsing.{Parser, Position, Positional, accept, chainl1, chainr1, elem, failure, guard, ident, literal, not, opt, parse, parseAll, positioned, rep, rep1, rep1sep, repN, repsep, success, wholeNumber}

// A node class that conforms to Positional, and describes itself with the position it was given.
open class Located(val kind: string): Positional
    describe() -> string = pos match
        Some(p) -> s"$kind@$p"
        None -> s"$kind@?"

// A subclass, which stores the position once, in its superclass.
class Call(val name: string, val arity: int): Located("call")

// An object conforming to Positional through its superclass.
object End: Located("end")

// A trait of its own beside Positional, each with a field.
trait Tagged
    var count: int = 1
    tag() -> string = s"$count@${where()}"
    where() -> string

class Word(val text: string): Positional, Tagged
    override where() -> string = pos.map(p -> s"$p").getOrElse("?")

lazy val numbers: Parser[List[long]] = repsep(number, literal(","))

lazy val digit: Parser[char] = elem("digit", c -> c.isDigit())

// `if` as a keyword, not the start of a longer name.
lazy val ifKeyword: Parser[string] = literal("if") <~ not(elem("letter", c -> c.isLetter()))

// `<b>text</b>`: the closing tag must repeat the opening one.
lazy val tagged: Parser[string] = literal("<") ~> ident.flatMap(open -> literal(">") ~> ident <~ literal("</") <~ literal(open) <~ literal(">"))

// The same with `into`.
lazy val taggedInto: Parser[string] = literal("<") ~> (ident into (open -> literal(">") ~> ident <~ literal("</") <~ literal(open) <~ literal(">")))

@test("a repetition takes none or more, and rep1 at least one")
repetitions()
    assertEq(all(rep(literal("a")), ""), "[]")
    assertEq(all(rep(literal("a")), "aaa"), "[a, a, a]")
    assertEq(all(rep1(literal("a")), ""), "failure 1:1: expected `a`, found end of input")
    assertEq(all(rep1(literal("a")), "aa"), "[a, a]")
    assertEq(all(rep(literal("ab")), "ab ab"), "[ab, ab]")
    assertEq(all(rep1(literal("ab")), "ab"), "[ab]")

@test("rep1 with a first parser reads it once, then the other as many times as it succeeds")
repetitionWithFirst()
    val name = rep1(elem("letter", c -> c.isLetter()), elem("letter or digit", c -> c.isLetterOrDigit()))
    assertEq(all(name, "a12b"), "[a, 1, 2, b]")
    assertEq(all(name, "a"), "[a]")
    assertEq(all(name, "1a"), "failure 1:1: expected letter, found '1'")
    assertEq(all(name, "a-"), "failure 1:2: expected letter or digit or end of input, found '-'")

@test("repN reads exactly n values, and fails short of them")
fixedRepetitions()
    assertEq(all(repN(3, digit), "123"), "[1, 2, 3]")
    assertEq(all(repN(0, digit), ""), "[]")
    assertEq(all(repN(3, digit), "12"), "failure 1:3: expected digit, found end of input")
    assertEq(all(repN(2, digit), "123"), "failure 1:3: expected end of input, found '3'")
    assertEq(all(repN(2, digit) ~ digit ^^ (match (ds, d) -> s"$ds $d"), "123"), "[1, 2] 3")
    assertEq(all(repN(2, digit) | rep(digit) ^^^ List.empty[char](), "1"), "[]")

@test("a repeated parser that reads nothing ends the repetition rather than looping")
repetitionOfNothing()
    assertEq(all(rep(opt(literal("-"))), ""), "[]")
    assertEq(all(rep(opt(digit) <~ literal(";")) ~> rep(digit), "1;2;;333"), "[3, 3, 3]")

@test("values separated by a separator, which must be followed by a value")
separated()
    assertEq(all(numbers, ""), "[]")
    assertEq(all(numbers, "7"), "[7]")
    assertEq(all(numbers, "1, 2 ,3"), "[1, 2, 3]")
    assertEq(all(numbers, "1, 2,"), "failure 1:6: expected whole number, found end of input")
    assertEq(all(repsep(number, literal(";")), "4; 5"), "[4, 5]")
    assertEq(all(rep1sep(number, literal(",")), ""), "failure 1:1: expected whole number, found end of input")
    assertEq(all(rep1sep(number, literal(",")), "8,9"), "[8, 9]")

@test("an optional part is Some when present and None when absent")
optional()
    assertEq(all(opt(accept('-')) ~ rep1(digit) ^^ (match (sign, d) -> s"$sign $d"), "12"), "None [1, 2]")
    assertEq(all(opt(accept('-')) ~ rep1(digit) ^^ (match (sign, d) -> s"$sign $d"), "-12"), "Some(-) [1, 2]")

@test("chainl1 combines from the left, and chainr1 folds from the right into its first value")
chains()
    val add = literal("+") ^^^ ((a: long, b: long) -> a + b)
    val minus = literal("-") ^^^ ((a: long, b: long) -> a - b)
    assertEq(all(chainl1(number, add), "5"), "5")
    assertEq(all(chainl1(number, minus), "10 - 3 - 2"), "5")
    assertEq(all(chainl1(number, minus), "10 - "), "failure 1:6: expected whole number, found end of input")
    assertEq(all(chainr1(number, minus, (a: long, b: long) -> a - b, 0), "5"), "5")
    assertEq(all(chainr1(number, minus, (a: long, b: long) -> a - b, 0), "10 - 3 - 2"), "9")
    val cons = literal(",") ^^^ ((x: long, xs: List[long]) -> x :: xs)
    assertEq(all(chainr1(number, cons, (x: long, xs: List[long]) -> x :: xs, List.empty[long]()), "1, 2, 3"), "[1, 2, 3]")

@test("chainl1 with a first parser folds values of another type into it")
chainsFromFirst()
    val call = chainl1(ident, number, literal("/") ^^^ ((acc: string, n: long) -> s"$acc($n)"))
    assertEq(all(call, "f"), "f")
    assertEq(all(call, "f / 1 / 2"), "f(1)(2)")
    assertEq(all(call, "f / x"), "failure 1:5: expected whole number, found 'x'")

@test("look ahead reads nothing")
lookAhead()
    assertEq(all(ifKeyword <~ literal("x"), "if x"), "if")
    assertEq(all(ifKeyword, "iffy"), "failure 1:1: expected `if`, found 'i'")
    assertEq(all(guard(literal("a")) ~> literal("ab"), "ab"), "ab")
    assertEq(all(guard(literal("b")) ~> literal("ab"), "ab"), "failure 1:1: expected `b`, found 'a'")

@test("what the parser inside a not expected is no part of the message")
lookAheadQuiet()
    // `if` then a number: the letter `not` refused to see is not what the text lacked.
    assertEq(all(ifKeyword ~ wholeNumber, "if)"), "failure 1:3: expected whole number, found ')'")
    assertEq(all(ifKeyword ~ wholeNumber, "if )"), "failure 1:4: expected whole number, found ')'")
    // At the end of the text too.
    assertEq(all(ifKeyword ~ wholeNumber, "if"), "failure 1:3: expected whole number, found end of input")
    // A label inside the look ahead relabels nothing outside it.
    assertEq(all(literal("a") <~ not(literal("b").withFailureMessage("bee")) ~ wholeNumber, "a)"), "failure 1:2: expected whole number, found ')'")
    // A not nested in a not is as quiet.
    assertEq(all(literal("a") <~ not(literal("b") ~ not(literal("c"))) ~ wholeNumber, "a)"), "failure 1:2: expected whole number, found ')'")
    assertEq(all(literal("a") <~ not(literal("b") ~ not(literal("c"))) ~ wholeNumber, "abc)"), "failure 1:2: expected whole number, found 'b'")
    // The not's own failure, where its parser succeeds and no literal comes just before, says what it
    // found.
    assertEq(all(not(literal("b")) ~> literal("b"), "b"), "failure 1:1: unexpected 'b'")
    assertEq(all(wholeNumber <~ not(literal("b")), "1b"), "failure 1:2: unexpected 'b'")
    // A failure the grammar reached before the look ahead is kept.
    assertEq(all(literal("a") ~ wholeNumber | literal("a") <~ not(literal("b")) ~ literal("c"), "a!"), "failure 1:2: expected whole number or `c`, found '!'")

@test("a not that refuses what follows a literal reports the literal as expected where it began")
refusedLiterals()
    assertEq(all(literal("a") <~ not(literal("b")), "ab"), "failure 1:1: expected `a`, found 'a'")
    assertEq(all(literal("a") ~ not(literal("b")), "ab"), "failure 1:1: expected `a`, found 'a'")
    assertEq(all(literal("a") ~> not(literal("b")), "ab"), "failure 1:1: expected `a`, found 'a'")
    // After white space, where the literal began.
    assertEq(all(ifKeyword, "  \n iffy"), "failure 2:2: expected `if`, found 'i'")
    // Beside the other alternatives, in the order they were tried.
    assertEq(all(ifKeyword | literal("else"), "iffy"), "failure 1:1: expected `if` or `else`, found 'i'")
    assertEq(all(literal("x") | ifKeyword, "iffy"), "failure 1:1: expected `x` or `if`, found 'i'")
    assertEq(all(ifKeyword | ident, "iffy"), "iffy")
    // The literal just before the look ahead, not an earlier one.
    assertEq(all(literal("a") ~ literal("if") <~ not(elem("letter", c -> c.isLetter())), "a iffy"), "failure 1:3: expected `if`, found 'i'")
    // A literal read inside the look ahead is not the one named.
    assertEq(all(literal("a") <~ not(literal("b") ~ literal("c")), "abc"), "failure 1:1: expected `a`, found 'a'")
    // Not when something was read between the literal and the look ahead.
    assertEq(all(literal("a") ~ elem('-') <~ not(literal("b")), "a-b"), "failure 1:3: unexpected 'b'")
    // A not inside a not names nothing outside it.
    assertEq(all(not(literal("a") <~ not(literal("b"))) ~> ident, "ab"), "ab")
    // A message from further on wins, as any does.
    assertEq(all(literal("a") ~> literal("b") ~> literal("c") | ifKeyword, "abd"), "failure 1:3: expected `c`, found 'd'")
    // A repetition of keywords stops at the name, and the message names the keyword it wanted.
    assertEq(all(rep(ifKeyword), "if if iffy"), "failure 1:7: expected `if` or end of input, found 'i'")

@test("a positioned value carries its line and its column in characters, after white space")
positions()
    val located = rep(positioned(ident ^^ (n -> Node(n)))) ^^ (xs -> xs.map(n -> n.where()).mkString(" "))
    assertEq(all(located, "alpha\n  béta g\n\ndelta"), "alpha@1:1 béta@2:3 g@2:8 delta@4:1")
    val offset = literal("x") ~> positioned(literal("y") ^^ (v -> Node(v))) ^^ (n -> n.pos.map(at -> at.offset).getOrElse(-1))
    assertEq(all(offset, "x  y"), "3")

@test("positioned keeps a position the value already has, and sets one only where there is none")
positionedOnce()
    val first = Node("a")
    first.setPos(Position(7, 3, 4))
    assertEq(all(positioned(literal("a") ^^ (_ -> first)) ^^ (n -> n.where()), "  a"), "a@3:4")
    assertEq(all(positioned(literal("a") ^^ (_ -> Node("a"))) ^^ (n -> n.where()), "  a"), "a@1:3")
    assertEq(all(positioned(literal("a") ^^ (_ -> Node("a"))) ^^ (n -> n.pos.isDefined()), "a"), "true")
    assertEq(Node("n").pos.isEmpty(), true)
    val inner = positioned(literal("b") ^^ (v -> Node(v)))
    assertEq(all(positioned(literal("a") ~> inner) ^^ (n -> n.where()), "a  b"), "b@1:4")

@test("a Positional class stores its position in the trait's field, which setPos sets once and assignment replaces")
positionalField()
    val n = Node("n")
    n.setPos(Position(0, 1, 1))
    n.setPos(Position(5, 2, 3))
    assertEq(n.where(), "n@1:1")
    n.pos = Some(Position(5, 2, 3))
    assertEq(n.where(), "n@2:3")
    val p: Positional = n
    p.pos = None
    assertEq(n.where(), "n@?")
    p.setPos(Position(9, 4, 2))
    assertEq(n.where(), "n@4:2")
    assertEq(p.pos.map(at -> at.offset).getOrElse(-1), 9)
    assertEq(Node("m").pos.isEmpty(), true)

@test("subclasses, objects and classes with other traits mix in Positional, and positioned sets each")
positionalShapes()
    val call = positioned(ident ^^ (f -> Call(f, 2))) ^^ (c -> s"${c.arity} ${c.describe()}")
    assertEq(all(call, "\n  f"), "2 call@2:3")
    val keyword = positioned(literal("end") ^^ (_ -> End)) ^^ (e -> e.describe())
    assertEq(all(keyword, " end"), "end@1:2")
    val counted = rep(positioned(ident ^^ (w -> Word(w)))) ^^ (ws -> ws.map(w -> s"${w.text}${w.tag()}").mkString(" "))
    assertEq(all(counted, "a b"), "a1@1:1 b1@1:3")

@test(">> is flatMap, and rep, rep1, repN, repsep and rep1sep answer a List")
shiftAndLists()
    assertEq(all(literal("<") ~> (ident >> (open -> literal(">") ~> ident <~ literal("</") <~ literal(open) <~ literal(">"))), "<b>bold</b>"), "bold")
    assertEq(all(literal("<") ~> (ident >> (open -> literal(">") ~> ident <~ literal("</") <~ literal(open) <~ literal(">"))), "<b>bold</i>"), "failure 1:10: expected `b`, found 'i'")
    val xs: Parser[List[string]] = rep(literal("a"))
    assertEq(all(xs, "a a"), "[a, a]")
    val ys: Parser[List[string]] = rep1(literal("a"))
    assertEq(all(ys, "a"), "[a]")
    val zs: Parser[List[char]] = repN(2, digit)
    assertEq(all(zs, "12"), "[1, 2]")
    val ws: Parser[List[long]] = rep1sep(number, literal(","))
    assertEq(all(ws, "1,2"), "[1, 2]")
    val vs: Parser[List[long]] = numbers
    assertEq(all(vs, ""), "[]")

@test("flatMap and into choose the next parser by the value read")
chosenByValue()
    assertEq(all(tagged, "<b>bold</b>"), "bold")
    assertEq(all(tagged, "<b>bold</i>"), "failure 1:10: expected `b`, found 'i'")
    assertEq(all(taggedInto, "<i>it</i>"), "it")
    assertEq(all(taggedInto, "<i>it</b>"), "failure 1:8: expected `i`, found 'b'")

@test("^? filters and maps in one step, failing where the function is not defined")
filteredAndMapped()
    val small = number ^? (match n if n < 100 -> s"small $n")
    assertEq(all(small, "42"), "small 42")
    assertEq(all(small, "420"), "failure 1:1: expected value the function is defined at, found '4'")
    val said = number.^?(match n if n < 100 -> s"small $n", n -> s"number below 100, not $n")
    assertEq(all(said, "420"), "failure 1:1: expected number below 100, not 420, found '4'")
    assertEq(all(said | ident, "x"), "x")
    assertEq(all(small | number ^^ (n -> s"large $n"), "420"), "large 420")

@test("a value filter or ^? refuses is reported where it began, after the white space before it")
refusedAfterWhiteSpace()
    val small = number.^?(match n if n < 100 -> n, n -> s"number below 100, not $n")
    assertEq(all(small, "  420"), "failure 1:3: expected number below 100, not 420, found '4'")
    assertEq(all(small, "\n 420"), "failure 2:2: expected number below 100, not 420, found '4'")
    assertEq(all(literal("(") ~> small, "( 420"), "failure 1:3: expected number below 100, not 420, found '4'")
    val even = number.filter(n -> n % 2 == 0)
    assertEq(all(even, "  7"), "failure 1:3: expected value the filter accepts, found '7'")
    // The alternative still starts where the refused parser did, white space included.
    assertEq(all(even | literal("7") ^^ (s -> s.toLongOption().getOrElse(0) + 1), " 7"), "8")
    assertEq(all(even ||| number, "  7"), "7")
    // A grammar that skips nothing reports at the value itself, which is where it started.
    assertEq(shown(Exact.parseAll(even, "7")), "failure 1:1: expected value the filter accepts, found '7'")

@test("||| keeps the longer of two matches, the first when they are as long")
longest()
    val lt = literal("<") ^^^ "lt"
    val le = literal("<") ~ literal("=") ^^^ "le"
    assertEq(all(lt ||| le, "<="), "le")
    assertEq(all(le ||| lt, "<="), "le")
    assertEq(all(lt ||| le, "<"), "lt")
    assertEq(all(lt ||| le, "< ="), "le")
    assertEq(all(literal("a") ^^^ 1 ||| literal("a") ^^^ 2, "a"), "1")
    assertEq(all(lt ||| le, "x"), "failure 1:1: expected `<`, found 'x'")
    assertEq(all(literal("x") ^^^ "x" ||| le, "<="), "le")

@test("success, failure, ^^^ and map give values of their own")
values()
    assertEq(all(success(long(42)), ""), "42")
    assertEq(all(literal("yes") ^^^ true, "yes"), "true")
    assertEq(all(literal("abc").map(s -> s.byteLength()), "abc"), "3")
    assertEq(all(failure[int]("anything at all") | success(7), "x"), "failure 1:1: expected anything at all or end of input, found 'x'")
    assertEq(all(failure[int]("anything at all") | success(7), ""), "7")

@test("parse reads a prefix and says where it stopped; parseAll needs the whole text")
prefixes()
    val r = parse(number, "12 abc")
    assertEq(s"${r.get()} ${r.next().offset} ${r.successful()}", "12 2 true")
    assertEq(shown(parse(number, "abc")), "failure 1:1: expected whole number, found 'a'")
    assertEq(shown(parseAll(number, "12 abc")), "failure 1:4: expected end of input, found 'a'")
    assertEq(shown(parseAll(number, " 12 \n")), "12")
