module tests

// Blocks: a small language whose blocks are marked by indentation, lexed into tokens and parsed
// with the token leaves. A program is lines of statements: `name = number`, `print name`, and
// `if name` followed by a block indented deeper, committed once its `if` is read. A comment runs
// from `#` to the end of its line.
//
//     a = 1
//     if a
//       print a  # shows 1
//     b = 2
import dev.avinlang.parsing.{
  LaidOut, Layout, Margin, ParseResult, Parser, Position, RegexParsers, Rule, TokenParsers, Tokens, elem, lineBreak,
  margin, not, opt, recover, rep, rep1, repsep, spanned
}

// Where a token stands: where it begins and where it ends. Every `At` equals every other, so two
// tokens compare by what they are and not by where, and the grammar's `token(Name("if"))` reads an
// `if` wherever it stands.
class At(val pos: Position, val end: Position)

impl Eq for At
  equals(other: At) -> bool = true

impl Hash for At
  hash() -> long = 0

// The place of a token written in a grammar rather than lexed: the start of the text.
nowhere() -> At = placed(0, 1, 1)

// A token at byte `offset` of the text, on `line` at `column`, ending where it begins.
placed(offset: int, line: int, column: int) -> At
  val p = Position(offset, line, column)
  At(p, p)

// The tokens of Blocks. A `Line` marks where a line begins, as the lexer reads it; the layout
// replaces the marks with `Newline`, `Indent` and `Dedent`, so the grammar never sees one.
data Tok
  Name(text: string, at: At = nowhere())
  Num(value: long, at: At = nowhere())
  Sym(text: string, at: At = nowhere())
  Line(margin: Margin)
  Newline(at: At = nowhere())
  Indent(at: At = nowhere())
  Dedent(at: At = nowhere())

impl Tok
  // Where the token stands in the text.
  place -> At = self match
    Name(_, a) -> a
    Num(_, a) -> a
    Sym(_, a) -> a
    Line(m) -> At(m.start, m.text)
    Newline(a) -> a
    Indent(a) -> a
    Dedent(a) -> a

  // Where the token begins in the text.
  where -> Position = place.pos

  // Where the token ends in the text.
  end -> Position = place.end

  // The token as a message shows it.
  shown -> string = self match
    Name(t, _) -> s"`$t`"
    Num(v, _) -> s"$v"
    Sym(t, _) -> s"`$t`"
    Line(_) -> "line start"
    Newline(_) -> "end of line"
    Indent(_) -> "indent"
    Dedent(_) -> "dedent"

// A token shows as a message shows it.
impl Display for Tok
  display(out: Writer, spec: FormatSpec) = out.write(shown)

// The lexer of Blocks, written with the string combinators: each line is a mark holding its margin,
// then its names, numbers and symbols. Between tokens it skips spaces, tabs and comments, never a
// line break.
object BlocksText: RegexParsers
  override whiteSpace() -> Parser[unit] = rep(
    elem("space", c -> c == ' ' || c == '\t') ^^^ () | elem('#') ~ rep(
      elem("comment", c -> c != '\n' && c != '\r')
    ) ^^^ ()
  ) ^^^ ()

  lazy val word: Parser[Tok] = spanned(
    elem("letter", c -> c.isLetter) ~ rep(elem("letter or digit", c -> c.isLetterOrDigit))
  ) ^^ (s -> Name((s.value.0 :: s.value.1).mkString(""), At(s.start, s.end)))
  lazy val number: Parser[Tok] = spanned(rep1(elem("digit", c -> c.isDigit))) ^^ (
    s -> Num(s.value.mkString("").toLongOption().getOrElse(0), At(s.start, s.end))
  )
  lazy val symbol: Parser[Tok] = spanned(
    elem("symbol", c -> !(c == ' ' || c == '\t' || c == '\n' || c.isLetterOrDigit))
  ) ^^ (s -> Sym(s"${s.value}", At(s.start, s.end)))
  lazy val item: Parser[Tok] = not(lineBreak) ~> (word | number | symbol)
  lazy val line: Parser[List[Tok]] = (margin ^^ (m -> Line(m))) ~ rep(item) ^^ (match (m, ts) -> m :: ts)
  lazy val lines: Parser[List[List[Tok]]] = repsep(line, lineBreak)

// The layout of Blocks: a block is indented any amount deeper than the one it is in. An indent or
// dedent stands where its line's first token is, a newline where the line's last token ends.
object BlocksLayout: Layout[Tok]
  override lineStart(t: Tok) -> Option[Margin] = t match
    Line(m) -> Some(m)
    _ -> None

  override indentToken(at: Margin) -> Tok = Indent(At(at.text, at.text))
  override dedentToken(at: Margin) -> Tok = Dedent(At(at.text, at.text))
  override newlineToken(at: Position) -> Tok = Newline(At(at, at))
  override tokenEnd(t: Tok) -> Position = t.end

// The marked lines of `text`, as the lexer reads them.
marked(text: string) -> Vector[Tok] = BlocksText.parseAll(BlocksText.lines, text).get().flatMap(l -> l).toVector

// The tokens of `text` laid out, with the layout's errors.
lexed(text: string) -> LaidOut[Tok] = BlocksLayout.layout(marked(text), endOfText(text))

// The tokens of `text`. A line indented deeper than the block it is in opens a block with an
// `Indent` where its first token is; a line indented less closes each block it leaves with a
// `Dedent` there. Then come its names, numbers and symbols, and a `Newline` where its last token
// ends. Blank and comment lines make no tokens, and every block still open at the end is closed
// where the text ends.
lex(text: string) -> Vector[Tok] = lexed(text).tokens

// Where `text` ends: its length, on its last line, one column past that line's last character.
endOfText(text: string) -> Position
  val lines = text.split('\n')
  Position(text.byteLength, lines.length, lines(lines.length - 1).byteLength + 1)

// The grammar of Blocks. Each statement answers itself as text, a block as its statements in
// braces.
object Blocks: TokenParsers[Tok]
  override describe(t: Tok) -> string = t.shown
  override span(t: Tok) -> Position = t.where

  lazy val name: Rule[Tokens[Tok], string] = tokenMatch("name", match Name(n, _) -> n)
  lazy val number: Rule[Tokens[Tok], long] = tokenMatch("number", match Num(v, _) -> v)
  lazy val symbol: Rule[Tokens[Tok], Tok] = token("symbol", t -> t is Sym(_, _))
  lazy val newline: Rule[Tokens[Tok], Tok] = token(Newline())

  lazy val assign: Rule[Tokens[Tok], string] = name ~ (token(Sym("=")) ~> number) <~ newline ^^ (
    match (n, v) -> s"$n = $v"
  )
  lazy val printStmt: Rule[Tokens[Tok], string] = token(Name("print")) ~> name <~ newline ^^ (n -> s"print $n")
  lazy val ifStmt: Rule[Tokens[Tok], string] = token(Name("if")) ~! (name ~ (newline ~> block)) ^^ (
    match (_, (c, b)) -> s"if $c $b"
  )
  lazy val block: Rule[Tokens[Tok], string] = token(Indent()) ~> rep1(stmt) <~ token(Dedent()) ^^ (
    ss -> s"{${ss.mkString("; ")}}"
  )
  lazy val stmt: Rule[Tokens[Tok], string] = ifStmt | printStmt | assign
  lazy val program: Rule[Tokens[Tok], List[string]] = rep(stmt)

  // Everything up to and including the end of the line, or to the end of the tokens.
  lazy val restOfLine: Rule[Tokens[Tok], unit] = rep(token("anything", t -> !(t is Newline(_)))) ~ opt(newline) ^^^ ()

  // A statement that recovers at the end of its line, standing as its error's position in angle
  // brackets.
  lazy val line: Rule[Tokens[Tok], string] = recover(stmt, restOfLine, (msg, at) -> s"<$at>")
  lazy val lines: Rule[Tokens[Tok], List[string]] = rep(line)

// `Blocks.parseAll(p, …)` of the tokens of `text`, the end of input where the text ends.
parseText[T](p: Rule[Tokens[Tok], T], text: string) -> ParseResult[T] = Blocks.parseAll(p, lex(text), endOfText(text))
