module tests

// Arithmetic expressions parsed and evaluated as they are parsed: `+` and `-` below `*` and `/`,
// below a right-grouping `^`, with unary minus and parentheses. This is the grammar the README shows.
import dev.avinlang.parsing.{Parser, chainl1, chainr1, literal, parseAll, wholeNumber}
import avin.threads.spawn

// `base` multiplied by itself `exponent` times.
power(base: long, exponent: long) -> long
power(_, n <= 0) = 1
power(base, n + 1) = base * power(base, n)

// An operator: the literal, yielding the function it applies.
op(text: string, f: @sendable (long, long) -> long) -> Parser[(long, long) -> long] = literal(text) ^^^ f


lazy val atom: Parser[long] = number
    | literal("(") ~> expr <~ literal(")")
    | literal("-") ~> atom ^^ (n -> -n)

lazy val factor: Parser[long] = chainr1(atom, op("^", power), power, 1)

lazy val term: Parser[long] = chainl1(factor, op("*", (a, b) -> a * b) | op("/", (a, b) -> a / b))

lazy val expr: Parser[long] = chainl1(term, op("+", (a, b) -> a + b) | op("-", (a, b) -> a - b))

@test("operators bind and group as arithmetic does")
arithmetic()
    assertEq(all(expr, "1 + 2 * 3"), "7")
    assertEq(all(expr, "(1 + 2) * 3"), "9")
    assertEq(all(expr, "2 ^ 3 ^ 2"), "512")
    assertEq(all(expr, "10 - 4 - 3"), "3")
    assertEq(all(expr, " -(2 + 3) * -2 "), "10")
    assertEq(all(expr, "- (1)"), "-1")

@test("a malformed expression names everything that could have come next")
arithmeticErrors()
    assertEq(all(expr, "2 * (3 + 4"), "failure 1:11: expected `^`, `*`, `/`, `+`, `-` or `)`, found end of input")
    assertEq(all(expr, "1 + * 2"), "failure 1:5: expected whole number, `(` or `-`, found '*'")
    assertEq(all(expr, "1 + 2 )"), "failure 1:7: expected `^`, `*`, `/`, `+`, `-` or end of input, found ')'")

nested(depth: int) -> string = "(".repeat(depth) + "1 + 2" + ")".repeat(depth)

// Nesting is recursion: each level of parentheses is a few calls deep in the parser, so the depth a
// grammar reaches is bounded by the stack it runs on.
@test("2,000 levels of parentheses fit the main thread's stack, and 10,000 a thread of 64 MiB")
depth()
    assertEq(all(expr, nested(2000)), "3")
    val deep = nested(10000)
    assertEq(spawn(() -> all(expr, deep), stack = 67108864).join(), "3")
    val unclosed = "(".repeat(10000) + "1" + ")".repeat(9999)
    assertEq(spawn(() -> all(expr, unclosed), stack = 67108864).join(), "failure 1:20001: expected `^`, `*`, `/`, `+`, `-` or `)`, found end of input")
