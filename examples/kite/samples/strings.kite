module strings

import io

// Interpolation, escapes and text in any script.
fn greet(name: string, times: i64) -> string {
    "Hello, {name}! ({times} {if times == 1 { "time" } else { "times" }})"
}

fn quote(s: string) -> string {
    "\"{s}\" has braces \{like this\} and a tab:\there"
}

fn label(n: i64) -> string {
    match n {
        0 => "zero"
        1 => "one"
        -1 => "minus one"
        _ => "many: {n}"
    }
}

fn main() {
    let größe = 3
    let 名前 = "世界"
    io.println(greet(名前, größe))
    io.println(quote("nested {"strings {"too"}"}"))
    io.println("snowman: \u{2603}, smile: 😀, newline next\n")
    io.println(label(-1) + ", " + label(größe))
}
