(module geometry)
(import math)
(type Point (record (x f64) (y f64)))
(type Shape (sum (Circle (center Point) (r f64)) (Rect (corner Point) (w f64) (h f64)) (Triangle (a Point) (b Point) (c Point)) (Empty)))
(fn area ((s Shape)) -> f64 (block (match s ((Circle _ r) (* (* 3.141592653589793 r) r)) ((Rect _ w h) (* w h)) ((Triangle a b c) (block (let twice (- (* (- (. b x) (. a x)) (- (. c y) (. a y))) (* (- (. c x) (. a x)) (- (. b y) (. a y))))) (/ (call (. math abs) twice) 2.0))) (Empty 0.0))))
(fn describe ((s Shape)) -> string (block (let kind (match s ((Circle _ _) "circle") ((Rect _ _ _) "rectangle") (_ "other"))) (str "a " kind " of area " (call area s))))
(fn main () (block (let origin (call Point x: 0.0 y: 0.0)) (let shapes (array (call Circle center: origin r: 1.5) (call Rect corner: origin w: 2.0 h: 3.0) (call Triangle a: origin b: (call Point x: 4.0 y: 0.0) c: (call Point x: 0.0 y: 3.0)))) (var total 0.0) (for i (.. 0 3) (block (+= total (call area (index shapes i))) (call print (call describe (index shapes i))))) (if (&& (> total 10.0) (< total 1000.0)) (block (call print (str "large: " total))) (block (call print (str "small: " total))))))
