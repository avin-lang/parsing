(module strings)
(import io)
(fn greet ((name string) (times i64)) -> string (block (str "Hello, " name "! (" times " " (if (== times 1) (block "time") (block "times")) ")")))
(fn quote ((s string)) -> string (block (str "\"" s "\" has braces \{like this\} and a tab:\there")))
(fn label ((n i64)) -> string (block (match n (0 "zero") (1 "one") (-1 "minus one") (_ (str "many: " n)))))
(fn main () (block (let größe 3) (let 名前 "世界") (call (. io println) (call greet 名前 größe)) (call (. io println) (call quote (str "nested " (str "strings " "too")))) (call (. io println) "snowman: ☃, smile: 😀, newline next\n") (call (. io println) (+ (+ (call label (- 1)) ", ") (call label größe)))))
