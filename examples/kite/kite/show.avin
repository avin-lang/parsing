module kite

// The syntax tree printed as S-expressions: one parenthesised form per node, the operator or keyword
// first, so grouping is visible at a glance. `1 + 2 * 3` prints as `(+ 1 (* 2 3))`.

// A string in Kite's own spelling: quoted, with its quotes, backslashes, braces and control
// characters escaped.
quoted(text: string) -> string
    val body = text.chars().map(escaped).mkString("")
    s"\"$body\""

// How a string writes the character `c`.
escaped(c: char) -> string
escaped('"') = "\\\""
escaped('\\') = "\\\\"
escaped('{') = "\\{"
escaped('}') = "\\}"
escaped('\n') = "\\n"
escaped('\t') = "\\t"
escaped('\r') = "\\r"
escaped('\u{0}') = "\\0"
escaped(c) = s"$c"

// A float as written, always with a point or an exponent so that it never reads as an integer;
// the infinities and NaN as `inf`, `-inf` and `NaN`.
floatText(x: real) -> string
    val t = s"$x"
    if t.contains(".") || t.contains("e") || t.contains("E") || t.contains("n") || t.contains("N") then t else s"${t}.0"

showType(t: TypeRef) -> string = t match
    NamedType(n, _) -> n
    ArrayType(e, size, _) -> s"[${showType(e)}; $size]"

showPattern(p: Pattern) -> string = p match
    WildPat(_) -> "_"
    IntPat(v, _) -> s"$v"
    FloatPat(v, _) -> floatText(v)
    StrPat(t, _) -> quoted(t)
    BoolPat(v, _) -> s"$v"
    NamePat(n, _) -> n
    VariantPat(n, fields, _) -> if fields.isEmpty() then s"($n)" else s"($n ${fields.map(showPattern).mkString(" ")})"
    ErrorPat(_) -> "(error)"

private showPart(p: StrPart) -> string = p match
    Text(t) -> quoted(t)
    Interp(e) -> show(e)

private showArg(a: Arg) -> string = a.name match
    Some(n) -> s"$n: ${show(a.value)}"
    None -> show(a.value)

// Forms after a head, each preceded by a space.
private tail(forms: List[string]) -> string = forms.map(f -> s" $f").mkString("")

show(e: Expr) -> string = e match
    IntLit(v, _) -> s"$v"
    FloatLit(v, _) -> floatText(v)
    BoolLit(v, _) -> s"$v"
    StrLit(parts, _) -> parts match
        Nil -> "\"\""
        Cons(Text(t), Nil) -> quoted(t)
        _ -> s"(str${tail(parts.map(showPart))})"
    Name(n, _) -> n
    ArrayLit(items, _) -> s"(array${tail(items.map(show))})"
    ArrayRepeat(item, count, _) -> s"(array-repeat ${show(item)} ${show(count)})"
    Unary(op, x, _) -> s"($op ${show(x)})"
    Binary(op, l, r, _) -> s"($op ${show(l)} ${show(r)})"
    RangeExpr(l, h, inclusive, _) -> s"(${if inclusive then "..=" else ".."} ${show(l)} ${show(h)})"
    Call(f, args, _) -> s"(call ${show(f)}${tail(args.map(showArg))})"
    Index(t, i, _) -> s"(index ${show(t)} ${show(i)})"
    Field(t, n, _) -> s"(. ${show(t)} $n)"
    BlockExpr(stmts, _) -> s"(block${tail(stmts.map(showStmt))})"
    If(c, t, o, _) -> o match
        Some(x) -> s"(if ${show(c)} ${show(t)} ${show(x)})"
        None -> s"(if ${show(c)} ${show(t)})"
    Match(x, arms, _) -> s"(match ${show(x)}${tail(arms.map(showArm))})"
    ErrorExpr(_) -> "(error)"

// An arm as its pattern and its body, or `(error)` where it could not be read.
private showArm(a: Arm) -> string = a.pattern match
    ErrorPat(_) -> "(error)"
    p -> s"(${showPattern(p)} ${show(a.body)})"

showStmt(s: Stmt) -> string = s match
    Let(mutable, n, declared, v, _) ->
        val kw = if mutable then "var" else "let"
        declared match
            Some(t) -> s"($kw $n ${showType(t)} ${show(v)})"
            None -> s"($kw $n ${show(v)})"
    Assign(op, t, v, _) -> s"($op ${show(t)} ${show(v)})"
    ExprStmt(e) -> show(e)
    While(c, b, _) -> s"(while ${show(c)} ${show(b)})"
    For(n, over, b, _) -> s"(for $n ${show(over)} ${show(b)})"
    Return(v, _) -> v match
        Some(x) -> s"(return ${show(x)})"
        None -> "(return)"
    Break(_) -> "(break)"
    Continue(_) -> "(continue)"
    ErrorStmt(_) -> "(error)"

private showField(f: FieldDecl) -> string = s"(${f.name} ${showType(f.declared)})"

showItem(i: Item) -> string = i match
    FnDecl(n, params, result, body, _) ->
        val ps = params.map(p -> s"(${p.name} ${showType(p.declared)})").mkString(" ")
        val r = result match
            Some(t) -> s" -> ${showType(t)}"
            None -> ""
        s"(fn $n ($ps)$r ${show(body)})"
    TypeDecl(n, d, _) -> d match
        Alias(t) -> s"(type $n (alias ${showType(t)}))"
        Record(fields) -> s"(type $n (record${tail(fields.map(showField))}))"
        Sum(variants) -> s"(type $n (sum${tail(variants.map(v -> s"(${v.name}${tail(v.fields.map(showField))})"))}))"
    ErrorItem(_) -> "(error)"

// A module, one form to a line: the header, each import, each declaration.
showModule(m: Module) -> string
    val header = s"(module ${m.name})"
    val forms = m.imports.map(i -> s"(import ${i.name})") ++ m.items.map(showItem)
    (header :: forms).mkString("\n")
