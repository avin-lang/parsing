// Parses a Kite source file and prints its syntax tree, one declaration to a line, or every syntax
// error in it, in order, each as `file:line:column: message`, ending with status 1.
//
//     avin run examples/kite -- examples/kite/samples/geometry.kite
import avin.fs
import avin.process.{args, exit}
import kite.{parseModule, showModule}

main()
    val given = args()
    if given.length() != 1
        eprintln("usage: kite <file.kite>")
        exit(2)
    val file = given(0)
    fs.readText(file) match
        Err(e) ->
            eprintln(s"$file: $e")
            exit(1)
        Ok(text) ->
            val r = parseModule(text)
            val errors = r.errors()
            if errors.isEmpty()
                println(showModule(r.get()))
            else
                for e in errors
                    eprintln(s"$file:$e")
                exit(1)
