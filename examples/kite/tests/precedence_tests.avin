module tests

// The operator table, loosest first: `||`; `&&`; the comparisons, which do not chain; the ranges,
// which do not chain; `+ -`; `* / %`; prefix `- !`; the suffixes (call, index, field). Every pair of
// neighbouring levels is checked both ways round, and every level's grouping.

@test("each binary operator makes its node")
eachOperator()
    for op in ["||", "&&", "==", "!=", "<", "<=", ">", ">=", "+", "-", "*", "/", "%"]
        assertEq(expr(s"a $op b"), s"($op a b)")
    assertEq(expr("a .. b"), "(.. a b)")
    assertEq(expr("a ..= b"), "(..= a b)")
    assertEq(expr("a..b"), "(.. a b)")
    assertEq(expr("a..=b"), "(..= a b)")
    assertEq(expr("a<=b"), "(<= a b)")
    assertEq(expr("a<b"), "(< a b)")

@test("the left-grouping levels group from the left")
leftGrouping()
    assertEq(expr("a || b || c"), "(|| (|| a b) c)")
    assertEq(expr("a && b && c"), "(&& (&& a b) c)")
    assertEq(expr("a - b - c"), "(- (- a b) c)")
    assertEq(expr("a - b + c"), "(+ (- a b) c)")
    assertEq(expr("a + b - c"), "(- (+ a b) c)")
    assertEq(expr("a / b / c"), "(/ (/ a b) c)")
    assertEq(expr("a * b % c"), "(% (* a b) c)")
    assertEq(expr("a % b * c"), "(* (% a b) c)")
    assertEq(expr("a / b * c"), "(* (/ a b) c)")

@test("each level binds tighter than the one before it, either way round")
neighbours()
    // || and &&
    assertEq(expr("a || b && c"), "(|| a (&& b c))")
    assertEq(expr("a && b || c"), "(|| (&& a b) c)")
    // && and the comparisons
    assertEq(expr("a && b == c"), "(&& a (== b c))")
    assertEq(expr("a == b && c"), "(&& (== a b) c)")
    assertEq(expr("a < b && c > d"), "(&& (< a b) (> c d))")
    // the comparisons and the ranges
    assertEq(expr("a == b..c"), "(== a (.. b c))")
    assertEq(expr("a..b == c"), "(== (.. a b) c)")
    assertEq(expr("a..=b != c..d"), "(!= (..= a b) (.. c d))")
    // the ranges and + -
    assertEq(expr("a..b + 1"), "(.. a (+ b 1))")
    assertEq(expr("a + 1..b"), "(.. (+ a 1) b)")
    assertEq(expr("0..=n - 1"), "(..= 0 (- n 1))")
    // + - and * / %
    assertEq(expr("a + b * c"), "(+ a (* b c))")
    assertEq(expr("a * b + c"), "(+ (* a b) c)")
    assertEq(expr("a - b / c"), "(- a (/ b c))")
    assertEq(expr("a % b - c"), "(- (% a b) c)")
    // * / % and prefix
    assertEq(expr("-a * b"), "(* (- a) b)")
    assertEq(expr("a * -b"), "(* a (- b))")
    assertEq(expr("!a && b"), "(&& (! a) b)")
    // prefix and the suffixes
    assertEq(expr("-a.b"), "(- (. a b))")
    assertEq(expr("-f(x)"), "(- (call f x))")
    assertEq(expr("!xs[0]"), "(! (index xs 0))")
    // a full chain
    assertEq(expr("a || b && c == d..e + f * -g.h"), "(|| a (&& b (== c (.. d (+ e (* f (- (. g h))))))))")
    assertEq(expr("-g.h * f + e..d == c && b || a"), "(|| (&& (== (.. (+ (* (- (. g h)) f) e) d) c) b) a)")

@test("parentheses override the table")
parentheses()
    assertEq(expr("(a + b) * c"), "(* (+ a b) c)")
    assertEq(expr("a - (b - c)"), "(- a (- b c))")
    assertEq(expr("(a < b) == c"), "(== (< a b) c)")
    assertEq(expr("(a..b)..c"), "(.. (.. a b) c)")
    assertEq(expr("((((x))))"), "x")
    assertEq(expr("-(a + b)"), "(- (+ a b))")
    assertEq(expr("(f)(x)"), "(call f x)")

@test("the prefix operators nest")
prefixes()
    assertEq(expr("- - a"), "(- (- a))")
    assertEq(expr("--a"), "(- (- a))")
    assertEq(expr("!!a"), "(! (! a))")
    assertEq(expr("-!a"), "(- (! a))")
    assertEq(expr("-1"), "(- 1)")
    assertEq(expr("- 1.5"), "(- 1.5)")
    assertEq(expr("a - -1"), "(- a (- 1))")
    assertEq(expr("a--1"), "(- a (- 1))")

@test("the suffixes chain from the left")
suffixes()
    assertEq(expr("f(x)(y)"), "(call (call f x) y)")
    assertEq(expr("a.b.c"), "(. (. a b) c)")
    assertEq(expr("a[0][1]"), "(index (index a 0) 1)")
    assertEq(expr("a.b(c)[d].e"), "(. (index (call (. a b) c) d) e)")
    assertEq(expr("f()"), "(call f)")
    assertEq(expr("f(a, b, c)"), "(call f a b c)")
    assertEq(expr("f(a,)"), "(call f a)")
    assertEq(expr("P(x: 1.0, y: -2.0)"), "(call P x: 1.0 y: (- 2.0))")
    assertEq(expr("f(a, n: b)"), "(call f a n: b)")
    assertEq(expr("a . b"), "(. a b)")
    assertEq(expr("1.max"), "(. 1 max)")
    assertEq(expr("xs[i + 1]"), "(index xs (+ i 1))")
    assertEq(expr("\"s\".len()"), "(call (. \"s\" len))")
    assertEq(expr("[1, 2][0]"), "(index (array 1 2) 0)")
    assertEq(expr("if c { a } else { b }.x"), "(. (if c (block a) (block b)) x)")

@test("a comparison or a range followed by another is an error at the second operator")
noChaining()
    assertEq(expr("a < b < c"), "error 1:7: expected `&&` between two comparisons, which do not chain, found '<'")
    assertEq(expr("a == b == c"), "error 1:8: expected `&&` between two comparisons, which do not chain, found '='")
    assertEq(expr("a < b >= c"), "error 1:7: expected `&&` between two comparisons, which do not chain, found '>'")
    assertEq(expr("a != b<c"), "error 1:7: expected `&&` between two comparisons, which do not chain, found '<'")
    assertEq(expr("a..b..c"), "error 1:5: expected the end of the range, since ranges do not chain, found '.'")
    assertEq(expr("a..b ..= c"), "error 1:6: expected the end of the range, since ranges do not chain, found '.'")
    assertEq(expr("(a < b < c)"), "error 1:8: expected `&&` between two comparisons, which do not chain, found '<'")
    // Grouped, or joined by &&, they are fine.
    assertEq(expr("a < b && b < c"), "(&& (< a b) (< b c))")
    assertEq(expr("(a < b) < c"), "(< (< a b) c)")
    assertEq(expr("a < (b < c)"), "(< a (< b c))")
    assertEq(expr("(a..b)..(c..d)"), "(.. (.. a b) (.. c d))")

@test("an operator is not the beginning of a longer one")
longestOperators()
    assertEq(expr("a<=b"), "(<= a b)")
    assertEq(expr("a>=b"), "(>= a b)")
    assertEq(expr("a!=b"), "(!= a b)")
    assertEq(expr("a==b"), "(== a b)")
    assertEq(expr("a..=b"), "(..= a b)")
    assertEq(expr("a.b"), "(. a b)")
    assertEq(expr("a+-b"), "(+ a (- b))")
    assertEq(expr("a*-b"), "(* a (- b))")
    assertEq(stmt("a+=b"), "(+= a b)")
    assertEq(stmt("a-=b"), "(-= a b)")
    assertEq(stmt("a*=b"), "(*= a b)")
    assertEq(stmt("a/=b"), "(/= a b)")
    assertEq(stmt("a%=b"), "(%= a b)")
    assertEq(stmt("a=b"), "(= a b)")
    assertEq(stmt("a==b"), "(== a b)")
    assertEq(stmt("a = -b"), "(= a (- b))")
