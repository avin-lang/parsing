module tests

// The tokens: comments, names and keywords, numbers, and strings with their escapes and
// interpolation.

@test("comments are white space wherever white space may be, and block comments nest")
comments()
    assertEq(expr("// before\na"), "a")
    assertEq(expr("/* before */ a /* after */"), "a")
    assertEq(expr("a // to the end"), "a")
    assertEq(expr("a //"), "a")
    assertEq(expr("a /**/"), "a")
    assertEq(expr("/* one /* two /* three */ two */ one */ a"), "a")
    assertEq(expr("/* a // line comment inside */ a"), "a")
    assertEq(expr("/* stars ** / * */ a"), "a")
    assertEq(expr("f(/* arg */ a /* , */)"), "(call f a)")
    assertEq(expr("a /* */ + /* */ b"), "(+ a b)")
    assertEq(expr("a/b"), "(/ a b)")
    assertEq(expr("a / b"), "(/ a b)")
    assertEq(expr("a /\nb"), "(/ a b)")
    assertEq(expr("a/*c*/*b"), "(* a b)")
    assertEq(expr("\"// not a comment\""), "\"// not a comment\"")
    assertEq(expr("\"/* not a comment */\""), "\"/* not a comment */\"")

@test("a block comment that is never closed is an error where it begins")
openComments()
    assertEq(expr("/* never closed"), s"error 1:1: expected $commentOpen, found '/'")
    assertEq(expr("a + /* never closed"), s"error 1:5: expected $commentOpen, found '/'")
    assertEq(expr("/* /* nested, the outer never closed */"), s"error 1:1: expected $commentOpen, found '/'")
    assertEq(body("a\n/* never closed\n"), s"error 4:1: expected $commentOpen, found '/'")
    assertEq(file("module m\n/* never closed"), s"error 2:1: expected $commentOpen, found '/'")

val commentOpen = "`*/` to close the comment that begins here"

@test("names are letters in any script, digits and _, and are not keywords")
names()
    assertEq(expr("x"), "x")
    assertEq(expr("_"), "_")
    assertEq(expr("_x1"), "_x1")
    assertEq(expr("größe"), "größe")
    assertEq(expr("名前"), "名前")
    assertEq(expr("π"), "π")
    assertEq(expr("x٣"), "x٣")
    assertEq(expr("iffy"), "iffy")
    assertEq(expr("format"), "format")
    assertEq(expr("returned"), "returned")
    assertEq(expr("true_"), "true_")
    assertEq(expr("in2"), "in2")
    assertEq(expr("f(größe: 1)"), "(call f größe: 1)")

@test("every keyword is refused as a name where a name is required")
keywordsAreNotNames()
    for k in ["module", "import", "fn", "type", "let", "var", "if", "else", "while", "for", "in", "match", "return", "break", "continue", "true", "false"]
        assertEq(stmt(s"let $k = 1"), s"error 1:5: expected name (`$k` is a keyword), found '${k.take(1)}'")
    assertEq(expr("a.fn"), "failure 1:3: expected name (`fn` is a keyword), found 'f'")
    assertEq(file("module m\nfn while() { }"), "error 2:4: expected name (`while` is a keyword), found 'w'")
    // A keyword where an expression should be is not one.
    assertEq(expr("in"), "failure 1:1: expected expression, found 'i'")

@test("integers")
integers()
    assertEq(expr("0"), "0")
    assertEq(expr("42"), "42")
    assertEq(expr("007"), "7")
    assertEq(expr("9223372036854775807"), "9223372036854775807")
    assertEq(expr("-9223372036854775807"), "(- 9223372036854775807)")
    assertEq(expr("9223372036854775808"), "error 1:1: expected integer of at most 9223372036854775807, the largest i64, found '9'")
    assertEq(expr("1 + 99999999999999999999"), "error 1:5: expected integer of at most 9223372036854775807, the largest i64, found '9'")
    assertEq(stmt("9223372036854775808"), "error 1:1: expected integer of at most 9223372036854775807, the largest i64, found '9'")
    assertEq(body("let x = -9223372036854775808"), "error 3:10: expected integer of at most 9223372036854775807, the largest i64, found '9'")
    assertEq(pat("9223372036854775808"), "error 1:1: expected integer of at most 9223372036854775807, the largest i64, found '9'")
    assertEq(typ("[i64; 9223372036854775808]"), "error 1:7: expected integer of at most 9223372036854775807, the largest i64, found '9'")
    assertEq(expr("12abc"), "failure 1:3: expected digit, found 'a'")
    assertEq(expr("1_000"), "failure 1:2: expected digit, found '_'")
    assertEq(expr("١٢"), "failure 1:1: expected expression, found '١'")

@test("floats have a fraction or an exponent")
floats()
    assertEq(expr("1.5"), "1.5")
    assertEq(expr("0.25"), "0.25")
    assertEq(expr("1e3"), "1000.0")
    assertEq(expr("1E3"), "1000.0")
    assertEq(expr("2.5e-3"), "0.0025")
    assertEq(expr("2.5e+3"), "2500.0")
    assertEq(expr("1.0"), "1.0")
    // A point not followed by a digit is not part of the number.
    assertEq(expr("1..2"), "(.. 1 2)")
    assertEq(expr("1..=2"), "(..= 1 2)")
    assertEq(expr("1.abs"), "(. 1 abs)")
    assertEq(expr("1.5.floor"), "(. 1.5 floor)")
    // An exponent with no digits is not an exponent, and the letter is then an error.
    assertEq(expr("1e"), "failure 1:2: expected digit, found 'e'")
    assertEq(expr("1e+"), "failure 1:2: expected digit, found 'e'")
    assertEq(expr(".5"), "failure 1:1: expected expression, found '.'")
    assertEq(expr("5."), "failure 1:3: expected name, found end of input")

@test("booleans")
booleans()
    assertEq(expr("true"), "true")
    assertEq(expr("false"), "false")
    assertEq(expr("!true || false"), "(|| (! true) false)")

@test("strings, and every escape")
strings()
    assertEq(expr("\"\""), "\"\"")
    assertEq(expr("\"hello\""), "\"hello\"")
    assertEq(expr("\"  spaces  kept  \""), "\"  spaces  kept  \"")
    assertEq(expr("\"a\\nb\""), "\"a\\nb\"")
    assertEq(expr("\"\\t\\r\\0\""), "\"\\t\\r\\0\"")
    assertEq(expr("\"\\\\\""), "\"\\\\\"")
    assertEq(expr("\"say \\\"hi\\\"\""), "\"say \\\"hi\\\"\"")
    assertEq(expr("\"\\{not interpolated\\}\""), "\"\\{not interpolated\\}\"")
    assertEq(expr("\"a } alone\""), "\"a \\} alone\"")
    assertEq(expr("\"\\u{41}\\u{e9}\\u{2603}\\u{1F600}\""), "\"Aé☃😀\"")
    assertEq(expr("\"\\u{0041}\""), "\"A\"")
    assertEq(expr("\"\\u{10FFFF}\"") == "\"\u{10FFFF}\"", true)
    assertEq(expr("\"größe 名前 😀\""), "\"größe 名前 😀\"")
    assertEq(expr("\"tab\there\""), "\"tab\\there\"")

@test("a bad escape is an error at the character after the backslash")
badEscapes()
    assertEq(expr("\"a\\qb\""), "error 1:4: expected escape (`\\n`, `\\t`, `\\r`, `\\0`, `\\\\`, `\\\"`, `\\{`, `\\}` or `\\u{…}`), found 'q'")
    assertEq(expr("\"\\"), "error 1:3: expected escape (`\\n`, `\\t`, `\\r`, `\\0`, `\\\\`, `\\\"`, `\\{`, `\\}` or `\\u{…}`), found end of input")
    assertEq(expr("\"\\u41\""), "error 1:4: expected `{`, hex digits and `}` after `\\u`, found '4'")
    assertEq(expr("\"\\u{}\""), "error 1:5: expected `{`, hex digits and `}` after `\\u`, found '}'")
    assertEq(expr("\"\\u{4g}\""), "error 1:6: expected `{`, hex digits and `}` after `\\u`, found 'g'")
    assertEq(expr("\"\\u{D800}\""), "error 1:10: expected Unicode scalar value (at most 10FFFF, and not D800 to DFFF) in `\\u{…}`, found '\"'")
    assertEq(expr("\"\\u{DFFF}\""), "error 1:10: expected Unicode scalar value (at most 10FFFF, and not D800 to DFFF) in `\\u{…}`, found '\"'")
    assertEq(expr("\"\\u{110000}\""), "error 1:12: expected Unicode scalar value (at most 10FFFF, and not D800 to DFFF) in `\\u{…}`, found '\"'")
    assertEq(expr("\"\\u{0000041}\""), "error 1:13: expected Unicode scalar value (at most 10FFFF, and not D800 to DFFF) in `\\u{…}`, found '\"'")
    assertEq(expr("\"\\u{FFFFFFFFFFFF}\""), "error 1:18: expected Unicode scalar value (at most 10FFFF, and not D800 to DFFF) in `\\u{…}`, found '\"'")

@test("a string not closed before its line ends is an error against its opening quote")
unclosedStrings()
    assertEq(expr("\"abc"), "error 1:5: expected `\"` to close the string at 1:1, found end of input")
    assertEq(expr("\"abc\ndef\""), "error 1:5: expected `\"` to close the string at 1:1, found '\\n'")
    assertEq(expr("f(x, \"abc)"), "error 1:11: expected `\"` to close the string at 1:6, found end of input")
    assertEq(body("let s = \"one\nlet t = 2"), "error 3:13: expected `\"` to close the string at 3:9, found '\\n'")

@test("interpolation holds any expression, strings and interpolation included")
interpolation()
    assertEq(expr("\"{x}\""), "(str x)")
    assertEq(expr("\"a{x}b\""), "(str \"a\" x \"b\")")
    assertEq(expr("\"{x}{y}\""), "(str x y)")
    assertEq(expr("\"{ x + 1 }\""), "(str (+ x 1))")
    assertEq(expr("\"{f(a, b)[0].c}\""), "(str (. (index (call f a b) 0) c))")
    assertEq(expr("\"{\"inner\"}\""), "(str \"inner\")")
    assertEq(expr("\"a {\"b {c} d\"} e\""), "(str \"a \" (str \"b \" c \" d\") \" e\")")
    assertEq(expr("\"{\"{\"{x}\"}\"}\""), "(str (str (str x)))")
    assertEq(expr("\"{if c { \"y\" } else { \"n\" }}\""), "(str (if c (block \"y\") (block \"n\")))")
    assertEq(expr("\"{{ a }}\""), "(str (block a))")
    assertEq(expr("\"{x}\\n\""), "(str x \"\\n\")")
    assertEq(expr("\"\\{x}\""), "\"\\{x\\}\"")
    assertEq(expr("\"{x} // not a comment\""), "(str x \" // not a comment\")")
    assertEq(expr("\"{x /* a comment */}\""), "(str x)")
    assertEq(expr("\"größe: {größe}\""), "(str \"größe: \" größe)")

@test("an interpolation that is empty or not closed is an error")
badInterpolation()
    assertEq(expr("\"{}\""), "error 1:3: expected expression, found '}'")
    assertEq(expr("\"{ }\""), "error 1:4: expected expression, found '}'")
    assertEq(expr("\"{"), "error 1:3: expected expression, found end of input")
    assertEq(expr("\"{x\""), "error 1:4: expected operator or `}` to close `{` at 1:2, found '\"'")
    assertEq(expr("\"ab {x y}\""), "error 1:8: expected operator or `}` to close `{` at 1:5, found 'y'")
    // The interpolation is a bracket, so a line end inside it is white space; outside it the text
    // may not hold one.
    assertEq(expr("\"{x\n}\""), "(str x)")
    assertEq(expr("\"{x}\n\""), "error 1:5: expected `\"` to close the string at 1:1, found '\\n'")
