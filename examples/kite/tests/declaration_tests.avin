module tests

// A file: its module line, its imports, and its function and type declarations.

@test("a file is a module line, imports and declarations")
files()
    assertEq(file("module m"), "(module m)")
    assertEq(file("module m\n"), "(module m)")
    assertEq(file("\n\n// a comment first\nmodule m\n\n"), "(module m)")
    assertEq(file("module kite.geometry"), "(module kite.geometry)")
    assertEq(file("module m\nimport a\nimport b.c.d"), "(module m)\n(import a)\n(import b.c.d)")
    assertEq(file("module m\nimport a\nfn f() { }\ntype T = i64"), "(module m)\n(import a)\n(fn f () (block))\n(type T (alias i64))")
    assertEq(file("module größe"), "(module größe)")

@test("a file without a module line, and an empty file, are errors at their start")
missingModule()
    assertEq(file(""), "failure 1:1: expected `module`, found end of input")
    assertEq(file("   \n  "), "failure 2:3: expected `module`, found end of input")
    assertEq(file("// only a comment"), "failure 1:18: expected `module`, found end of input")
    assertEq(file("fn f() { }"), "failure 1:1: expected `module`, found 'f'")
    assertEq(file("module"), "error 1:7: expected name, found end of input")
    assertEq(file("module 1"), "error 1:8: expected name, found '1'")
    assertEq(file("module m.\nfn f() { }"), "error 2:1: expected name (`fn` is a keyword), found 'f'")
    assertEq(file("modulem"), "failure 1:1: expected `module`, found 'm'")

@test("declarations and imports end at their line")
oneToALine()
    assertEq(file("module m import a"), "error 1:10: expected `.` or end of line, found 'i'")
    assertEq(file("module m\nimport a fn f() { }"), "error 2:10: expected `.` or end of line, found 'f'")
    assertEq(file("module m\nfn f() { } fn g() { }"), "failure 2:12: expected end of line, found 'f'")
    assertEq(file("module m\nimport a\nfn f() { }\nimport b"), "failure 4:1: expected `fn`, `type` or end of input, found 'i'")
    assertEq(file("module m\nlet x = 1"), "failure 2:1: expected `import`, `fn`, `type` or end of input, found 'l'")

@test("functions: parameters, a result type, a body")
functions()
    assertEq(file("module m\nfn f() { }"), "(module m)\n(fn f () (block))")
    assertEq(file("module m\nfn f() -> i64 { 1 }"), "(module m)\n(fn f () -> i64 (block 1))")
    assertEq(file("module m\nfn add(a: i64, b: i64) -> i64 { a + b }"), "(module m)\n(fn add ((a i64) (b i64)) -> i64 (block (+ a b)))")
    assertEq(file("module m\nfn f(xs: [f64; 3],) { }"), "(module m)\n(fn f ((xs [f64; 3])) (block))")
    assertEq(file("module m\nfn f(s: Shape) -> [Point; 2] { }"), "(module m)\n(fn f ((s Shape)) -> [Point; 2] (block))")
    assertEq(file("module m\nfn f() {\n  return\n}"), "(module m)\n(fn f () (block (return)))")
    assertEq(file("module m\nfn() { }"), "error 2:3: expected name, found '('")
    assertEq(file("module m\nfn f { }"), "error 2:6: expected `(`, found '{'")
    assertEq(file("module m\nfn f(a) { }"), "error 2:7: expected `:`, found ')'")
    assertEq(file("module m\nfn f(a: ) { }"), "error 2:9: expected type, found ')'")
    assertEq(file("module m\nfn f(a: i64 b: i64) { }"), "error 2:13: expected `,` or `)` to close `(` at 2:5, found 'b'")
    assertEq(file("module m\nfn f() -> { }"), "error 2:11: expected type, found '{'")
    assertEq(file("module m\nfn f() i64 { }"), "error 2:8: expected `->` or `{`, found 'i'")
    assertEq(file("module m\nfn f()"), "error 2:7: expected `->` or `{`, found end of input")
    assertEq(file("module m\nfnf() { }"), "failure 2:1: expected `import`, `fn`, `type` or end of input, found 'f'")

@test("types: an alias, a record, a sum")
typeDeclarations()
    assertEq(file("module m\ntype Meters = f64"), "(module m)\n(type Meters (alias f64))")
    assertEq(file("module m\ntype Row = [i64; 4]"), "(module m)\n(type Row (alias [i64; 4]))")
    assertEq(file("module m\ntype P = { x: f64, y: f64 }"), "(module m)\n(type P (record (x f64) (y f64)))")
    assertEq(file("module m\ntype P = { x: f64, y: f64, }"), "(module m)\n(type P (record (x f64) (y f64)))")
    assertEq(file("module m\ntype Unit = { }"), "(module m)\n(type Unit (record))")
    assertEq(file("module m\ntype P = {\n  x: f64,\n  y: f64,\n}"), "(module m)\n(type P (record (x f64) (y f64)))")
    assertEq(file("module m\ntype S = | Circle(r: f64) | Rect(w: f64, h: f64)"), "(module m)\n(type S (sum (Circle (r f64)) (Rect (w f64) (h f64))))")
    assertEq(file("module m\ntype S = | One"), "(module m)\n(type S (sum (One)))")
    assertEq(file("module m\ntype S = | A() | B"), "(module m)\n(type S (sum (A) (B)))")
    assertEq(file("module m\ntype S =\n  | A(p: P)\n  | B\n\nfn f() { }"), "(module m)\n(type S (sum (A (p P)) (B)))\n(fn f () (block))")
    assertEq(file("module m\ntype S = | A(\n  x: i64,\n)"), "(module m)\n(type S (sum (A (x i64))))")

@test("type declaration errors")
typeErrors()
    assertEq(file("module m\ntype = i64"), "error 2:6: expected name, found '='")
    assertEq(file("module m\ntype T i64"), "error 2:8: expected `=`, found 'i'")
    assertEq(file("module m\ntype T =="), "error 2:8: expected `=`, found '='")
    assertEq(file("module m\ntype T ="), "error 2:9: expected `|`, `{` or type, found end of input")
    assertEq(file("module m\ntype S = A | B"), "failure 2:12: expected end of line, found '|'")
    assertEq(file("module m\ntype S = |"), "error 2:11: expected name, found end of input")
    assertEq(file("module m\ntype S = | A | 1"), "failure 2:16: expected name, found '1'")
    assertEq(file("module m\ntype P = { x f64 }"), "error 2:14: expected `:`, found 'f'")
    assertEq(file("module m\ntype P = { x: f64 y: f64 }"), "error 2:19: expected `,` or `}` to close `{` at 2:10, found 'y'")
    assertEq(file("module m\ntype P = { x: f64"), "error 2:18: expected `,` or `}` to close `{` at 2:10, found end of input")
