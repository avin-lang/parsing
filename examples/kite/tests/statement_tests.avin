module tests

// Every statement form, blocks, `if` and `match` as expressions, arrays, and the types a
// declaration names.

@test("let and var, with and without a type")
bindings()
    assertEq(stmt("let x = 1"), "(let x 1)")
    assertEq(stmt("var x = 1"), "(var x 1)")
    assertEq(stmt("let x: i64 = 1"), "(let x i64 1)")
    assertEq(stmt("var xs: [f64; 3] = [0.0; 3]"), "(var xs [f64; 3] (array-repeat 0.0 3))")
    assertEq(stmt("let p: Point = Point(x: 1.0, y: 2.0)"), "(let p Point (call Point x: 1.0 y: 2.0))")
    assertEq(stmt("let s = if c { 1 } else { 2 }"), "(let s (if c (block 1) (block 2)))")
    assertEq(stmt("letx = 1"), "(= letx 1)")
    assertEq(stmt("let x"), "error 1:6: expected `:` or `=`, found end of input")
    assertEq(stmt("let = 1"), "error 1:5: expected name, found '='")
    assertEq(stmt("let x: = 1"), "error 1:8: expected type, found '='")
    assertEq(stmt("let x == 1"), "error 1:7: expected `:` or `=`, found '='")
    assertEq(stmt("let x = "), "error 1:9: expected expression, found end of input")

@test("assignment and the compound assignments, to any expression")
assignments()
    for op in ["=", "+=", "-=", "*=", "/=", "%="]
        assertEq(stmt(s"x $op 1"), s"($op x 1)")
    assertEq(stmt("xs[i] = 0"), "(= (index xs i) 0)")
    assertEq(stmt("p.x += 1.0"), "(+= (. p x) 1.0)")
    assertEq(stmt("g[i][j] = g[j][i]"), "(= (index (index g i) j) (index (index g j) i))")
    // Whether the left side is a place is the checker's question.
    assertEq(stmt("f() = 1"), "(= (call f) 1)")
    assertEq(stmt("a + b = c"), "(= (+ a b) c)")
    assertEq(stmt("x = y = z"), "failure 1:7: expected operator or end of input, found '='")
    assertEq(stmt("x ="), "failure 1:4: expected expression, found end of input")

@test("while, for, return, break and continue")
loops()
    assertEq(stmt("while i < n { i += 1 }"), "(while (< i n) (block (+= i 1)))")
    assertEq(stmt("while true { }"), "(while true (block))")
    assertEq(stmt("for i in 0..10 { f(i) }"), "(for i (.. 0 10) (block (call f i)))")
    assertEq(stmt("for i in 1..=n { }"), "(for i (..= 1 n) (block))")
    assertEq(stmt("for x in xs { }"), "(for x xs (block))")
    assertEq(stmt("for i in 0..n + 1 { }"), "(for i (.. 0 (+ n 1)) (block))")
    assertEq(stmt("return"), "(return)")
    assertEq(stmt("return 1 + 2"), "(return (+ 1 2))")
    assertEq(stmt("break"), "(break)")
    assertEq(stmt("continue"), "(continue)")
    assertEq(stmt("breaking"), "breaking")
    // A block is an expression, so it is read as the condition, and the body is then missing.
    assertEq(stmt("while { }"), "error 1:10: expected operator or `{`, found end of input")
    assertEq(stmt("while { c } { }"), "(while (block c) (block))")
    assertEq(stmt("while"), "error 1:6: expected expression, found end of input")
    assertEq(stmt("while c"), "error 1:8: expected operator or `{`, found end of input")
    assertEq(stmt("for 1 in xs { }"), "error 1:5: expected name, found '1'")
    assertEq(stmt("for i xs { }"), "error 1:7: expected `in`, found 'x'")
    assertEq(stmt("for i in xs"), "error 1:12: expected operator or `{`, found end of input")

@test("blocks are expressions, and a block's statements are kept in order")
blocks()
    assertEq(expr("{ }"), "(block)")
    assertEq(expr("{}"), "(block)")
    assertEq(expr("{ 1 }"), "(block 1)")
    assertEq(expr("{ let x = 1\n x + 1 }"), "(block (let x 1) (+ x 1))")
    assertEq(expr("{ { { 1 } } }"), "(block (block (block 1)))")
    assertEq(expr("{ 1 } + { 2 }"), "(+ (block 1) (block 2))")
    assertEq(body("{\n  a\n}\n{ b }"), "(block a) (block b)")
    assertEq(body("let x = {\n  let y = 2\n  y * y\n}"), "(let x (block (let y 2) (* y y)))")

@test("if is an expression with an optional else, which is a block or another if")
ifs()
    assertEq(expr("if c { a }"), "(if c (block a))")
    assertEq(expr("if c { a } else { b }"), "(if c (block a) (block b))")
    assertEq(expr("if a { 1 } else if b { 2 } else { 3 }"), "(if a (block 1) (if b (block 2) (block 3)))")
    assertEq(expr("if a { 1 } else if b { 2 }"), "(if a (block 1) (if b (block 2)))")
    assertEq(expr("if a && !b { }"), "(if (&& a (! b)) (block))")
    assertEq(expr("if if a { b } else { c } { d }"), "(if (if a (block b) (block c)) (block d))")
    assertEq(expr("if c { a } else { b } + 1"), "(+ (if c (block a) (block b)) 1)")
    assertEq(expr("if c a"), "error 1:6: expected operator or `{`, found 'a'")
    assertEq(expr("if c { a } else b"), "error 1:17: expected `if` or `{`, found 'b'")
    assertEq(expr("if { a }"), "error 1:9: expected operator or `{`, found end of input")
    assertEq(expr("if ) { a }"), "error 1:4: expected expression, found ')'")
    assertEq(expr("ifc { a }"), "failure 1:5: expected operator or end of input, found '{'")

@test("match takes arms of a pattern, => and an expression, ended by a line, a comma or the }")
matches()
    assertEq(expr("match x { }"), "(match x)")
    assertEq(expr("match x { _ => 0 }"), "(match x (_ 0))")
    assertEq(expr("match x { 0 => a, 1 => b, _ => c }"), "(match x (0 a) (1 b) (_ c))")
    assertEq(expr("match x { 0 => a, }"), "(match x (0 a))")
    assertEq(expr("match x {\n  0 => a\n  1 => b\n}"), "(match x (0 a) (1 b))")
    assertEq(expr("match x {\n  0 => a,\n  1 => b,\n}"), "(match x (0 a) (1 b))")
    assertEq(expr("match s { Circle(r) => r * r, Rect(w, h) => w * h }"), "(match s ((Circle r) (* r r)) ((Rect w h) (* w h)))")
    assertEq(expr("match x { 0 => { a\n b } }"), "(match x (0 (block a b)))")
    assertEq(expr("match match x { _ => y } { _ => z }"), "(match (match x (_ y)) (_ z))")
    assertEq(expr("match x { 0 => match y { _ => 1 } }"), "(match x (0 (match y (_ 1))))")
    assertEq(expr("match x { _ => 0 } + 1"), "(+ (match x (_ 0)) 1)")
    assertEq(expr("match x { 0 a }"), "error 1:13: expected `=>`, found 'a'")
    assertEq(expr("match x { 0 => }"), "error 1:16: expected expression, found '}'")
    assertEq(expr("match x { 0 => a 1 => b }"), "error 1:18: expected operator, `,`, end of line or `}`, found '1'")
    assertEq(expr("match x { + => a }"), "error 1:11: expected pattern or `}` to close `{` at 1:9, found '+'")
    assertEq(expr("match { }"), "error 1:10: expected operator or `{`, found end of input")

@test("patterns")
patterns()
    assertEq(pat("_"), "_")
    assertEq(pat("x"), "x")
    assertEq(pat("_x"), "_x")
    assertEq(pat("None"), "None")
    assertEq(pat("0"), "0")
    assertEq(pat("-1"), "-1")
    assertEq(pat("- 1"), "-1")
    assertEq(pat("1.5"), "1.5")
    assertEq(pat("-2.5"), "-2.5")
    assertEq(pat("9223372036854775807"), "9223372036854775807")
    assertEq(pat("true"), "true")
    assertEq(pat("false"), "false")
    assertEq(pat("\"text\""), "\"text\"")
    assertEq(pat("\"a\\nb\""), "\"a\\nb\"")
    assertEq(pat("\"\""), "\"\"")
    assertEq(pat("Circle(r)"), "(Circle r)")
    assertEq(pat("Rect(_, h)"), "(Rect _ h)")
    assertEq(pat("Unit()"), "(Unit)")
    assertEq(pat("Pair(Some(1), \"x\", true, _,)"), "(Pair (Some 1) \"x\" true _)")
    assertEq(pat("Rect(\n  w,\n  h\n)"), "(Rect w h)")
    assertEq(pat("\"{x}\""), "error 1:2: expected text: a pattern's string cannot interpolate, so write a brace as `\\{`, found '{'")
    assertEq(pat("a + b"), "failure 1:3: expected `(` or end of input, found '+'")
    assertEq(pat("Rect(w h)"), "error 1:8: expected `(`, `,` or `)` to close `(` at 1:5, found 'h'")
    assertEq(pat("if"), "failure 1:1: expected pattern, found 'i'")
    assertEq(pat("-x"), "failure 1:2: expected number, found 'x'")
    assertEq(pat(""), "failure 1:1: expected pattern, found end of input")

@test("arrays: items, a trailing comma, and an item repeated")
arrays()
    assertEq(expr("[]"), "(array)")
    assertEq(expr("[ ]"), "(array)")
    assertEq(expr("[1]"), "(array 1)")
    assertEq(expr("[1, 2, 3]"), "(array 1 2 3)")
    assertEq(expr("[1, 2, 3,]"), "(array 1 2 3)")
    assertEq(expr("[[1, 2], [3]]"), "(array (array 1 2) (array 3))")
    assertEq(expr("[0; 8]"), "(array-repeat 0 8)")
    assertEq(expr("[0.0; n * 2]"), "(array-repeat 0.0 (* n 2))")
    assertEq(expr("[[0; 3]; 3]"), "(array-repeat (array-repeat 0 3) 3)")
    assertEq(expr("[\"a\", if c { 1 } else { 2 }, f(x)]"), "(array \"a\" (if c (block 1) (block 2)) (call f x))")
    assertEq(expr("[,]"), "error 1:2: expected expression or `]` to close `[` at 1:1, found ','")
    assertEq(expr("[1,,2]"), "error 1:4: expected expression or `]` to close `[` at 1:1, found ','")
    assertEq(expr("[1; 2; 3]"), "error 1:6: expected operator or `]` to close `[` at 1:1, found ';'")
    assertEq(expr("[1, 2; 3]"), "error 1:6: expected operator, `,` or `]` to close `[` at 1:1, found ';'")

@test("types: names and fixed arrays")
types()
    assertEq(typ("i64"), "i64")
    assertEq(typ("f64"), "f64")
    assertEq(typ("bool"), "bool")
    assertEq(typ("string"), "string")
    assertEq(typ("Shape"), "Shape")
    assertEq(typ("[i64; 3]"), "[i64; 3]")
    assertEq(typ("[i64;0]"), "[i64; 0]")
    assertEq(typ("[[f64; 2]; 3]"), "[[f64; 2]; 3]")
    assertEq(typ("[ Point ; 10 ]"), "[Point; 10]")
    assertEq(typ("[i64]"), "failure 1:5: expected `;`, found ']'")
    assertEq(typ("[i64; n]"), "failure 1:7: expected number, found 'n'")
    assertEq(typ("[i64; 2.5]"), "failure 1:7: expected whole number for the array's length, found '2'")
    assertEq(typ("[i64; -1]"), "failure 1:7: expected number, found '-'")
    assertEq(typ("[i64; 3"), "error 1:8: expected `]` to close `[` at 1:1, found end of input")
    assertEq(typ("fn"), "failure 1:1: expected type, found 'f'")
    assertEq(typ("1"), "failure 1:1: expected type, found '1'")
